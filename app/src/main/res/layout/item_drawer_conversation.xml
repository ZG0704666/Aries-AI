<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerConversationItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/m3t_spacing_xs"
    android:background="@drawable/bg_drawer_conversation_item"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/m3t_drawer_conversation_item_padding_h"
    android:paddingVertical="@dimen/m3t_drawer_conversation_item_padding_v">

    <TextView
        android:id="@+id/tvDrawerConversationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.M3t.Title.Medium"
        android:textColor="@color/m3t_on_surface" />

    <TextView
        android:id="@+id/tvDrawerConversationSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/m3t_spacing_xs"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.M3t.Body.Small"
        android:textColor="@color/m3t_on_surface_variant" />

</LinearLayout>
