<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3t_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.M3t.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/m3t_background"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@color/m3t_on_surface_variant"
        app:title="@string/settings_title"
        app:titleTextColor="@color/m3t_on_surface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/m3t_spacing_lg"
        android:paddingTop="@dimen/m3t_spacing_md"
        android:paddingEnd="@dimen/m3t_spacing_lg"
        android:paddingBottom="@dimen/m3t_spacing_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_subtitle"
                android:textAppearance="@style/TextAppearance.M3t.Body.Medium"
                android:textColor="@color/m3t_on_surface_variant" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.M3t.Card.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/m3t_spacing_lg"
                app:cardBackgroundColor="@color/m3t_drawer_section_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/m3t_dialog_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_api"
                        android:textAppearance="@style/TextAppearance.M3t.Title.Medium"
                        android:textColor="@color/m3t_on_surface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_xs"
                        android:text="@string/settings_api_description"
                        android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                        android:textColor="@color/m3t_on_surface_variant" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.M3t.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_lg"
                        android:hint="@string/m3t_sidebar_api_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/apiInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textNoSuggestions|textVisiblePassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPasteApiInput"
                            style="@style/Widget.M3t.Button.Tonal.Compact"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/m3t_compact_button_height"
                            android:text="@string/m3t_sidebar_api_paste" />

                        <TextView
                            android:id="@+id/btnGetApiKey"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/m3t_spacing_md"
                            android:background="?attr/selectableItemBackground"
                            android:paddingVertical="@dimen/m3t_spacing_xs"
                            android:text="@string/m3t_sidebar_get_api_key"
                            android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                            android:textColor="@color/m3t_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/m3t_sidebar_third_party_api"
                            android:textAppearance="@style/TextAppearance.M3t.Body.Medium"
                            android:textColor="@color/m3t_on_surface" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swUseThirdPartyApi"
                            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:useMaterialThemeColors="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/apiThirdPartyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_md"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.M3t.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/drawer_api_base_url_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/apiBaseUrlInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/drawer_api_base_url_hint"
                                android:inputType="textUri" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.M3t.TextInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/m3t_spacing_md"
                            android:hint="@string/drawer_api_model_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/apiModelInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/drawer_api_model_hint"
                                android:inputType="textNoSuggestions" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_md"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/m3t_sidebar_local_model_mode"
                            android:textAppearance="@style/TextAppearance.M3t.Body.Medium"
                            android:textColor="@color/m3t_on_surface" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swUseLocalModel"
                            style="@style/Widget.Material3.CompoundButton.MaterialSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:useMaterialThemeColors="true" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckApi"
                        style="@style/Widget.M3t.Button.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/m3t_compact_button_height"
                        android:layout_marginTop="@dimen/m3t_spacing_lg"
                        android:text="@string/m3t_sidebar_check_connection"
                        app:icon="@drawable/ic_check_circle_24"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/m3t_spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadQwenModel"
                        style="@style/Widget.M3t.Button.Tonal.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/m3t_compact_button_height"
                        android:layout_marginTop="@dimen/m3t_spacing_sm"
                        android:text="@string/m3t_sidebar_qwen_download"
                        app:icon="@drawable/ic_update"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/m3t_spacing_sm" />

                    <TextView
                        android:id="@+id/apiStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/m3t_spacing_sm"
                        android:gravity="center"
                        android:text="@string/m3t_sidebar_api_not_checked"
                        android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                        android:textColor="@color/m3t_on_surface_variant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.M3t.Card.Subtle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/m3t_spacing_md"
                app:cardBackgroundColor="@color/m3t_drawer_section_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/m3t_dialog_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_actions"
                        android:textAppearance="@style/TextAppearance.M3t.Title.Medium"
                        android:textColor="@color/m3t_on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAutomation"
                        style="@style/Widget.M3t.Button.Tonal.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/m3t_compact_button_height"
                        android:layout_marginTop="@dimen/m3t_spacing_lg"
                        android:text="@string/settings_open_automation"
                        app:icon="@drawable/ic_tune_24"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/m3t_spacing_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenAbout"
                        style="@style/Widget.M3t.Button.Tonal.Compact"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/m3t_compact_button_height"
                        android:layout_marginTop="@dimen/m3t_spacing_sm"
                        android:text="@string/settings_open_about"
                        app:icon="@drawable/ic_developer"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/m3t_spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
