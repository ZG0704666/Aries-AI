<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/m3t_dialog_padding"
    android:paddingTop="36dp"
    android:paddingEnd="@dimen/m3t_dialog_padding"
    android:paddingBottom="@dimen/m3t_spacing_xxl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/m3t_spacing_xxl">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white_shadow"
            android:contentDescription="App Icon"
            android:elevation="0dp"
            android:padding="2dp"
            android:src="@mipmap/ic_launcher_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.02"
                android:text="Aries AI"
                android:textAppearance="@style/TextAppearance.M3t.Title.Large"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="智能手机助手"
                android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.M3t.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/m3t_dialog_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/m3t_spacing_md">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_key_24"
                    app:tint="@color/m3t_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="API 配置"
                    android:textAppearance="@style/TextAppearance.M3t.Title.Medium"
                    android:textSize="15sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/apiInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/m3t_spacing_md"
                android:background="@drawable/bg_input_field_flat"
                android:hint="输入 API Key"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:textColor="@color/m3t_on_surface"
                android:textColorHint="@color/m3t_on_surface_variant"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_public_24"
                    app:tint="@color/m3t_on_surface" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="使用第三方 OpenAI 兼容 API"
                    android:textAppearance="@style/TextAppearance.M3t.Title.Medium"
                    android:textSize="15sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swUseThirdPartyApi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/apiThirdPartyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/m3t_spacing_md"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="@dimen/m3t_spacing_xs"
                        android:text="Base URL"
                        android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                        android:textColor="@color/m3t_on_surface" />

                    <EditText
                        android:id="@+id/apiBaseUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_input_field_flat"
                        android:hint="https://api.example.com/v1"
                        android:inputType="textUri"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/m3t_on_surface"
                        android:textColorHint="@color/m3t_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="@dimen/m3t_spacing_xs"
                        android:text="Model"
                        android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                        android:textColor="@color/m3t_on_surface" />

                    <EditText
                        android:id="@+id/apiModelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field_flat"
                        android:hint="glm-4-flash"
                        android:inputType="textNoSuggestions"
                        android:minHeight="42dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/m3t_on_surface"
                        android:textColorHint="@color/m3t_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnGetApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/m3t_spacing_lg"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="@dimen/m3t_spacing_xs"
                android:paddingEnd="@dimen/m3t_spacing_xs"
                android:text="获取 API Key >"
                android:textColor="@color/m3t_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckApi"
                style="@style/Widget.M3t.Button.Filled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="验证连接"
                android:textSize="15sp"
                app:icon="@drawable/ic_check_circle_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <TextView
                android:id="@+id/apiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="10dp"
                android:text="未检测"
                android:textAppearance="@style/TextAppearance.M3t.Body.Small"
                android:textColor="@color/m3t_on_surface_variant"
                android:textSize="12sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>

