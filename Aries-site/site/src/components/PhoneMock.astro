---
import { Image } from 'astro:assets';
import brand from '../assets/brand-mark.png';

interface Props {
  id: string;
  label: string;
  caption: string;
  src?: string;
  alt?: string;
  featured?: boolean;
  tilt?: 'left' | 'right' | 'none';
}

const { id, label, caption, src, alt, featured = false, tilt = 'none' } = Astro.props;
---

<figure class:list={['phone', { 'phone--featured': featured, [`phone--${tilt}`]: tilt !== 'none' }]}>
  <div
    class="phone__trigger"
    role="button"
    tabindex="0"
    aria-label={`查看${label}详情`}
    data-phone-preview={id}
  >
    <div class="phone__frame">
      <span class="phone__notch" aria-hidden="true"></span>
      <div class="phone__screen">
        {
          src ? (
            <img
              class="phone__shot"
              src={src}
              alt={alt ?? label}
              width="420"
              height="910"
              loading={featured ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <div class="phone__placeholder">
              <Image src={brand} alt="" width={56} height={56} class="phone__brand" />
              <span class="phone__label">{label}</span>
              <span class="phone__hint">截图待补</span>
            </div>
          )
        }
        <span class="phone__zoom-hint">点击查看详情</span>
      </div>
    </div>
  </div>
  <figcaption class="phone__caption">{caption}</figcaption>
</figure>

{
  src && (
    <dialog class="phone-modal" data-phone-modal={id} aria-label={`${label}详情`}>
      <div class="phone-modal__panel">
        <button class="phone-modal__close" type="button" aria-label="关闭详情">×</button>
        <img class="phone-modal__image" src={src} alt={alt ?? label} decoding="async" />
        <div class="phone-modal__caption">
          <strong>{label}</strong>
          <span>{caption}</span>
        </div>
      </div>
    </dialog>
  )
}

<style>
  .phone {
    position: relative;
    flex: 0 0 auto;
    margin: 0;
    width: min(250px, 27vw);
    transition: transform 0.4s var(--ease);
  }

  .phone--featured {
    width: min(290px, 31vw);
    z-index: 2;
  }

  .phone + .phone {
    margin-left: -36px;
  }

  .phone--left {
    transform: translateX(20%) rotate(-6deg) scale(0.92);
  }

  .phone--right {
    transform: translateX(-20%) rotate(6deg) scale(0.92);
  }

  .phone--left:hover {
    transform: translateX(16%) rotate(-4deg) scale(0.94);
  }

  .phone--right:hover {
    transform: translateX(-16%) rotate(4deg) scale(0.94);
  }

  .phone__frame {
    position: relative;
    padding: 9px;
    border: 1px solid var(--border-strong);
    border-radius: 42px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03));
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(18px);
  }

  .phone__trigger {
    position: relative;
    cursor: zoom-in;
    border-radius: 42px;
    outline: none;
  }

  .phone__trigger:focus-visible {
    box-shadow: 0 0 0 3px var(--accent-3);
  }

  .phone__trigger::after {
    position: absolute;
    right: 18px;
    bottom: 18px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.72);
    color: #182033;
    content: '放大查看';
    font-size: 11px;
    font-weight: 750;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    box-shadow:
      0 8px 22px rgba(20, 35, 70, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .phone__trigger:hover::after,
  .phone__trigger:focus-visible::after {
    opacity: 1;
    transform: translateY(0);
  }

  .phone--featured .phone__frame {
    box-shadow:
      0 40px 110px rgba(0, 0, 0, 0.55),
      0 0 70px rgba(91, 140, 255, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .phone__notch {
    position: absolute;
    top: 15px;
    left: 50%;
    z-index: 3;
    width: 74px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    transform: translateX(-50%);
  }

  .phone__screen {
    position: relative;
    aspect-ratio: 9 / 19.2;
    overflow: hidden;
    border-radius: 34px;
    background:
      radial-gradient(120% 80% at 20% 0%, rgba(91, 140, 255, 0.22), transparent 55%),
      radial-gradient(100% 70% at 100% 100%, rgba(167, 139, 250, 0.2), transparent 60%),
      #080a12;
  }

  .phone__shot {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .phone__zoom-hint {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .phone__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 100%;
    padding: 24px;
    text-align: center;
  }

  .phone__brand {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    opacity: 0.9;
    filter: drop-shadow(0 10px 24px rgba(91, 140, 255, 0.35));
  }

  .phone__label {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
  }

  .phone__hint {
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  .phone__caption {
    margin-top: 14px;
    color: var(--text-muted);
    font-size: 12px;
    text-align: center;
  }

  .phone-modal {
    width: min(94vw, 1180px);
    height: min(92vh, 1080px);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
  }

  :global(html.phone-preview-open) {
    overflow: hidden;
  }

  .phone-modal::backdrop {
    background: rgba(3, 5, 12, 0.78);
    backdrop-filter: blur(14px);
    animation: phone-modal-backdrop 0.55s var(--ease) both;
  }

  .phone-modal__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 100%;
    max-height: 92vh;
    padding: clamp(18px, 3vw, 36px);
    border: 1px solid var(--border-strong);
    border-radius: clamp(24px, 4vw, 42px);
    background:
      radial-gradient(circle at 50% 0%, rgba(91, 140, 255, 0.2), transparent 55%),
      var(--bg);
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.5);
      overflow-y: auto;
      overscroll-behavior: contain;
      animation: phone-modal-open 0.72s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .phone-modal__image {
      width: min(56vw, 680px);
      max-width: 100%;
      height: auto;
      max-height: none;
      flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: clamp(18px, 3vw, 30px);
    object-fit: contain;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.45);
  }

  .phone-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: rgba(5, 6, 10, 0.7);
    color: #fff;
    font-size: 25px;
    line-height: 1;
  }

  .phone-modal__caption {
    position: relative;
    right: auto;
    bottom: auto;
    left: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: baseline;
    width: min(100%, 680px);
    margin-top: 16px;
    padding: 12px 18px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.78);
    color: #182033;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow:
      0 10px 30px rgba(20, 35, 70, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.92);
  }

  .phone-modal__caption span {
    color: #52617a;
    font-size: 13px;
  }

  @keyframes phone-modal-open {
    from {
      opacity: 0;
      transform: translateY(12vh) scale(0.48) rotate(-2deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1) rotate(0);
    }
  }

  @keyframes phone-modal-backdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 899px) {
    .hero__stage {
      width: 100%;
      margin-left: 0;
    }

    .phone--left,
    .phone--right {
      display: none;
    }

    .phone + .phone {
      margin-left: 0;
    }
  }

  @media (max-width: 560px) {
    .phone {
      width: min(330px, 84vw);
    }

    .phone--featured {
      width: min(350px, 88vw);
    }

    .phone-modal {
      width: 94vw;
    }

    .phone-modal__panel {
      min-height: 72vh;
      padding: 14px;
    }

    .phone-modal__image {
      width: 88vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-modal__panel,
    .phone-modal::backdrop {
      animation: none;
    }
  }
</style>

<script>
  if (!document.documentElement.dataset.phonePreviewReady) {
    document.documentElement.dataset.phonePreviewReady = 'true';
  const triggers = document.querySelectorAll<HTMLElement>('[data-phone-preview]');

  triggers.forEach((trigger) => {
    const id = trigger.dataset.phonePreview;
    const modal = id ? document.querySelector<HTMLDialogElement>(`[data-phone-modal="${id}"]`) : null;
    if (!modal) return;

    const close = modal.querySelector<HTMLButtonElement>('.phone-modal__close');
    const open = () => {
      modal.showModal();
      document.documentElement.classList.add('phone-preview-open');
    };
    const dismiss = () => {
      modal.close();
      document.documentElement.classList.remove('phone-preview-open');
    };

    trigger.addEventListener('click', open);
    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open();
      }
    });
    close?.addEventListener('click', dismiss);
    modal.addEventListener('click', (event) => {
      if (event.target === modal) dismiss();
    });
    modal.addEventListener('close', () => {
      document.documentElement.classList.remove('phone-preview-open');
    });
  });
  }
</script>
