---
import site from '../data/site.generated.json';
---

<section class="cta section">
  <div class="container">
    <div class="cta__panel">
      <div class="cta__glow" aria-hidden="true"></div>
      <div class="cta__content">
        <span class="eyebrow">开始使用</span>
        <h2 class="h2">把重复操作，交给 Aries</h2>
        <p class="cta__slogan">开启手机智能交互新时代。</p>
        <p class="lede">下载安装包，开启无障碍与悬浮窗权限，配置模型后即可开始。</p>
        <div class="cta__actions">
          <button class="btn btn--primary" type="button" data-open-download>
            下载 {site.release.tag}
          </button>
          <a class="btn btn--ghost" href={site.github} target="_blank" rel="noreferrer">
            在 GitHub 上查看
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-top: 20px;
  }

  .cta__panel {
    position: relative;
    overflow: hidden;
    padding: clamp(36px, 6vw, 64px);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(120deg, rgba(56, 182, 227, 0.16), rgba(240, 183, 208, 0.1) 50%, rgba(43, 212, 190, 0.1)),
      color-mix(in srgb, var(--bg) 72%, transparent);
    text-align: center;
  }

  .cta__glow {
    position: absolute;
    top: -40%;
    left: 50%;
    width: 70%;
    height: 120%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(56, 182, 227, 0.25), transparent 65%);
    filter: blur(40px);
    transform: translateX(-50%);
  }

  .cta__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta__slogan {
    margin-top: 14px;
    color: var(--text-soft);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 30px;
  }
</style>
